#!/usr/bin/env python3
"""Whitelist fake ssh for direct Ceph CLI black-box tests.

Every invocation appends its full argv to ``FAKE_SSH_LOG`` as one JSON line, so
tests can assert the external command ledger.  Nothing is answered on argv
shape alone: the shared SSH option vector is matched exactly, and each of the
three permitted invocations — verbose debug probe, node bootstrap, Ceph CLI
read command — must match its complete argv, with the Ceph command itself
dispatched by exact remote argv.  The bootstrap's Python source is not merely
required to be nonempty: it must hash to the digest pinned below, so arbitrary
remote source fails just as loudly as an extra token.  Anything else exits 99,
so a collector that appends an unexpected or mutating token fails the suite
immediately.
"""

from __future__ import annotations

import hashlib
import hmac
import gzip
import bz2
import lzma
import subprocess
import io
import json
import os
import re
import shlex
import sys
import tarfile
import time
import base64


CEPH_RESPONSES = {
    "status --format json-pretty": '{"health":"HEALTH_OK","fsid":"fsid-1"}',
    "status": "cluster is healthy",
    "health detail --format json-pretty": '{"checks":[{"severity":"HEALTH_OK"}]}',
    "health detail": "HEALTH_OK",
    "versions --format json-pretty": '{"mon":"19.2.3","mgr":"19.2.3"}',
    "df detail --format json-pretty": '{"stats":{"total_bytes":100}}',
    "osd tree --format json-pretty": '{"nodes":[{"id":0,"name":"osd.0"}]}',
    "osd tree": "ID CLASS WEIGHT TYPE NAME STATUS",
    "osd df --format json-pretty": '{"nodes":[{"id":0,"utilization":10}]}',
    "osd dump --format json-pretty": '{"osds":[{"osd":0,"state":["up","in"]}]}',
    "osd perf --format json-pretty": '{"osd_perf_infos":[{"id":0}]}',
    "osd blocked-by --format json-pretty": '{"blocked_by":[]}',
    "pg stat --format json-pretty": '{"pg_summary":{"num_pgs":33}}',
    "pg dump --format json-pretty": '{"pg_map":{"version":7}}',
    "pg dump_stuck --format json-pretty": '{"stuck":[]}',
    "mon dump --format json-pretty": '{"mons":[{"name":"a"}]}',
    "quorum_status --format json-pretty": '{"quorum":[0,1,2]}',
    "mgr dump --format json-pretty": '{"active_name":"a"}',
    "orch host ls --format json-pretty": '[{"hostname":"monitor01"}]',
    "orch ps --format json-pretty": '[{"daemon_type":"mon"}]',
    "orch ps": "NAME HOST STATUS",
    "orch device ls --wide --format json-pretty": '[{"path":"/dev/sdb"}]',
    "config dump --format json-pretty": '[{"who":"mon.a","value":"1"}]',
}

CRASH_IDS = (
    "crash-01",
    "crash/02",
    "crash:02",
    "crash-04",
    "crash-05",
    "crash-06",
    "crash-07",
    "crash-08",
    "crash-09",
    "crash-10",
    "crash-11",
    "crash-12",
)

# Dynamic-but-constrained argv slots: identity path, timeouts, known_hosts file
# list and SSH target.  Everything else in the option vector is fixed text.
IDENTITY_PATH = re.compile(r"[^-\s]\S*")
CONNECT_TIMEOUT = re.compile(r"ConnectTimeout=[1-9][0-9]*")
ALIVE_INTERVAL = re.compile(r"ServerAliveInterval=[1-9][0-9]*")
KNOWN_HOSTS_FILE = re.compile(r"UserKnownHostsFile=[^\s][^\n]*")
SSH_TARGET = re.compile(
    r"(?:[A-Za-z0-9._%+-]+@)?(?:\[[0-9A-Fa-f:]+\]|[A-Za-z0-9._:-]+)"
)
ENCODED_CONFIG = re.compile(r"[A-Za-z0-9_-]+")

# The one Python source this fake will ever run a bootstrap for, pinned here as
# an independent SHA-256 of the production REMOTE_BOOTSTRAP text.  The fixture
# deliberately does not import the production constant: pinning the digest is
# what makes "the collector sent the reviewed bootstrap, not merely *a* Python
# program" an assertion rather than an assumption.  When the production
# bootstrap legitimately changes, this digest must be updated by hand — the
# whole node-collection suite fails closed until it is.  Regenerate with:
#   python3 -c 'import hashlib, ceph_incident_collectors as c; \
#     print(hashlib.sha256(c.REMOTE_BOOTSTRAP.encode("utf-8")).hexdigest())'
BOOTSTRAP_SOURCE_SHA256 = (
    "420c17c1f51ef9dd5ff069edcd9cf4620eadc4ffa3f9d584d0afe9688c75f544"
)


class PinnedDigest:
    """An argv slot that accepts exactly one text, identified by its digest."""

    def __init__(self, hexdigest: str) -> None:
        self.hexdigest = hexdigest

    def accepts(self, actual: str) -> bool:
        return hmac.compare_digest(
            hashlib.sha256(actual.encode("utf-8")).hexdigest(), self.hexdigest
        )


BOOTSTRAP_SOURCE = PinnedDigest(BOOTSTRAP_SOURCE_SHA256)

CAPABILITY_PROBE = 'caps=""; command -v cephadm >/dev/null 2>&1 && caps="$caps cephadm"; command -v ceph >/dev/null 2>&1 && caps="$caps ceph"; command -v kubectl >/dev/null 2>&1 && caps="$caps kubectl"; printf "%s\\n" "$caps"'

Matcher = str | re.Pattern[str] | PinnedDigest

BASE_OPTIONS: tuple[Matcher, ...] = (
    "-i",
    IDENTITY_PATH,
    "-o",
    "BatchMode=yes",
    "-o",
    "IdentitiesOnly=yes",
    "-o",
    "IdentityAgent=none",
    "-o",
    "LogLevel=ERROR",
    "-o",
    CONNECT_TIMEOUT,
    "-o",
    ALIVE_INTERVAL,
    "-o",
    "ServerAliveCountMax=1",
)
TRUSTED_HOST_KEY_OPTIONS: tuple[Matcher, ...] = (
    "-o",
    "StrictHostKeyChecking=accept-new",
    "-o",
    KNOWN_HOSTS_FILE,
)


def matches(expected: Matcher, actual: str) -> bool:
    if isinstance(expected, PinnedDigest):
        return expected.accepts(actual)
    if isinstance(expected, re.Pattern):
        return expected.fullmatch(actual) is not None
    return expected == actual


def matches_all(expected: tuple[Matcher, ...], actual: list[str]) -> bool:
    return len(actual) == len(expected) and all(
        matches(item, actual[index]) for index, item in enumerate(expected)
    )


def reject(reason: str) -> None:
    sys.stderr.write(f"unexpected ssh command ({reason}): {shlex.join(arguments)}\n")
    raise SystemExit(99)


def remaining_after_base_options(argv: list[str]) -> list[str]:
    """Consume the exact shared SSH option vector and return the rest."""

    if not matches_all(BASE_OPTIONS, argv[: len(BASE_OPTIONS)]):
        reject("base SSH options")
    rest = argv[len(BASE_OPTIONS) :]
    if rest[:1] == ["-o"]:
        if not matches_all(TRUSTED_HOST_KEY_OPTIONS, rest[:4]):
            reject("host key options")
        rest = rest[4:]
    return rest


def emit(payload: str, code: int = 0) -> None:
    sys.stdout.write(payload if payload.endswith("\n") else payload + "\n")
    raise SystemExit(code)


def node_archive(alias: str, *, skip_logs: bool) -> bytes:
    log_artifact = (
        "logs/var-log/SKIPPED.txt" if skip_logs else "logs/var-log/INDEX.tsv"
    )
    files = {
        "system/hostname.txt": f"{alias}\n".encode(),
        log_artifact: (
            b"SKIPPED: --skip-logs\n"
            if skip_logs
            else b"path\tdisposition\tdetail\n"
        ),
    }
    if os.environ.get("FAKE_NODE_COMPRESSED_SECRET"):
        files["logs/var-log/merged/tree/files/ceph.log.gz"] = gzip.compress(
            b"safe evidence\nsecret = must-not-leak\n", mtime=0
        )
        files["logs/var-log/raw/opaque.tar.gz"] = gzip.compress(
            b"secret = intentionally opaque\n", mtime=0
        )
    if os.environ.get("FAKE_NODE_COMPRESSED_BOMB"):
        files["logs/var-log/merged/tree/files/bomb.log.gz"] = gzip.compress(
            b"safe evidence\n" + b"x" * (64 * 1024) + b"\nsecret = must-not-leak\n",
            mtime=0,
        )
    if os.environ.get("FAKE_NODE_ALL_CODECS_SECRET"):
        codec_payload = b"safe evidence\nsecret = must-not-leak\n"
        files["logs/var-log/merged/tree/files/ceph.log.gz"] = gzip.compress(
            codec_payload, mtime=0
        )
        files["logs/var-log/merged/tree/files/ceph.log.xz"] = lzma.compress(
            codec_payload
        )
        files["logs/var-log/merged/tree/files/ceph.log.bz2"] = bz2.compress(
            codec_payload
        )
        encoded_zstd = subprocess.run(
            ["zstd", "-q", "-c"],
            input=codec_payload,
            stdout=subprocess.PIPE,
            check=True,
        )
        files["logs/var-log/merged/tree/files/ceph.log.zst"] = encoded_zstd.stdout
    if os.environ.get("FAKE_NODE_POST_REDACTION_CAP"):
        files["logs/var-log/merged/tree/files/ceph.merged"] = b"key=x\n"
        files["logs/var-log/PAYLOAD-BYTES.txt"] = b"6\n"
    if os.environ.get("FAKE_NODE_PAYLOAD_ROOT_FILE"):
        files["logs/var-log/merged"] = b"123456789\n"
        files["logs/var-log/PAYLOAD-BYTES.txt"] = b"0\n"
    if os.environ.get("FAKE_NODE_CORRUPT_GZIP"):
        files["logs/var-log/merged/tree/files/corrupt.log.gz"] = (
            b"not a gzip stream\n"
        )
    if os.environ.get("FAKE_NODE_PROMETHEUS_LOOKALIKE"):
        files[
            "cluster/prometheus/fake-job/lookalike.json.gz"
        ] = gzip.compress(b"secret = must-redact-lookalike\n", mtime=0)
    entries = []
    for name in files:
        entries.append(
            {
                "host": alias,
                "collector": "collect-node",
                "artifact": f"/tmp/ceph-incident-node.fixture/out/{name}",
                "command": (
                    "hostname"
                    if name == "system/hostname.txt"
                    else "safe var-log fixture"
                ),
                "exit_code": 0,
                "started": "2026-07-29T00:00:00Z",
                "ended": "2026-07-29T00:00:01Z",
            }
        )
    files["manifest.jsonl"] = (
        "".join(json.dumps(entry) + "\n" for entry in entries)
    ).encode()
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w:gz") as archive:
        for name, payload in files.items():
            member = tarfile.TarInfo(name)
            member.size = len(payload)
            archive.addfile(member, io.BytesIO(payload))
    return buffer.getvalue()


def serve_debug_probe(rest: list[str]) -> None:
    if not matches_all(
        ("-vvv", "-o", "LogLevel=DEBUG3", SSH_TARGET, "true"), rest
    ):
        reject("debug probe argv")
    sys.stdout.write("debug1: fake verbose ssh probe\ndebug3: fake verbose detail\n")
    sys.stderr.write("debug1: connection closed by fixture\n")
    raise SystemExit(255)


def serve_bootstrap(remote_command: str) -> None:
    try:
        words = shlex.split(remote_command)
    except ValueError:
        reject("unparseable remote command")
    if not matches_all(("python3", "-c", BOOTSTRAP_SOURCE, ENCODED_CONFIG), words):
        reject("node bootstrap remote command")
    sys.stdin.buffer.read()
    padding = "=" * (-len(words[3]) % 4)
    config: dict[str, object] = {}
    try:
        decoded = json.loads(base64.urlsafe_b64decode(words[3] + padding))
        if not isinstance(decoded, dict):
            raise TypeError
        config = decoded
        configured_alias = str(config["host_alias"])
    except (ValueError, KeyError, TypeError):
        configured_alias = "monitor01"
    alias = os.environ.get("FAKE_NODE_ALIAS", configured_alias)
    config_log = os.environ.get("FAKE_NODE_CONFIG_LOG")
    if config_log:
        with open(config_log, "a", encoding="utf-8") as output:
            output.write(json.dumps(config) + "\n")
    sys.stdout.buffer.write(
        node_archive(alias, skip_logs=bool(config.get("skip_logs")))
    )
    exit_code = int(os.environ.get("FAKE_NODE_EXIT", "0"))
    if os.environ.get("FAKE_NODE_EXIT_ALIAS") == alias:
        exit_code = 17
    raise SystemExit(exit_code)


def serve_capability_probe(words: list[str]) -> None:
    if words != [CAPABILITY_PROBE]:
        reject("capability probe")
    emit(os.environ.get("FAKE_NODE_CAPS", "ceph kubectl"))


def serve_ceph_probe(words: list[str], target: str) -> None:
    if os.environ.get("FAKE_CEPH_PROBE_FAIL_TARGET") == target:
        raise SystemExit(17)
    if words == ["ceph", "--connect-timeout", "5", "-s"]:
        if os.environ.get("FAKE_DIRECT_PROBE_FAIL"):
            raise SystemExit(17)
        raise SystemExit(0)
    if words == ["sudo", "-n", "ceph", "--connect-timeout", "5", "-s"]:
        if os.environ.get("FAKE_SUDO_PROBE_FAIL"):
            raise SystemExit(17)
        raise SystemExit(0)
    reject("ceph runner probe")


def serve_ceph(words: list[str]) -> None:
    remote = " ".join(words)

    if os.environ.get("FAKE_SSH_CONNECT_FAIL"):
        sys.stderr.write("ssh: connect to host port 22: Connection refused\n")
        raise SystemExit(255)

    if os.environ.get("FAKE_SSH_MISSING_CEPH"):
        sys.stderr.write("bash: ceph: command not found\n")
        raise SystemExit(127)

    sleep_on = os.environ.get("FAKE_SSH_SLEEP_ON")
    if sleep_on and sleep_on in remote:
        time.sleep(float(os.environ.get("FAKE_SSH_SLEEP_SECONDS", "30")))
        raise SystemExit(0)

    fail_on = os.environ.get("FAKE_SSH_FAIL_ON")
    if fail_on and fail_on in remote:
        sys.stderr.write(f"simulated failure for {fail_on}\n")
        raise SystemExit(17)

    if remote == "config dump --format json-pretty" and os.environ.get(
        "FAKE_CEPH_SECRET_CONFIG"
    ):
        emit('[{"who":"mon.a","secret":"must-not-leak"}]')
    if remote == "config dump --format json-pretty" and os.environ.get(
        "FAKE_CEPH_PRIVATE_KEY_CONFIG"
    ):
        emit("-----BEGIN OPENSSH PRIVATE KEY-----\nkey material")
    if remote == "config dump --format json-pretty" and os.environ.get(
        "FAKE_CEPH_KEY_MATERIAL_CONFIG"
    ):
        # A safe line, Ceph key material in both spellings, and a whole PEM block:
        # the shapes the content-safety contract must blank line by line.
        emit(
            "mon_host = 10.0.0.1\n"
            "key = AQBn0123456789012345678901234567890123456==\n"
            '"auth_key": "AQBn0123456789012345678901234567890123456=="\n'
            "-----BEGIN OPENSSH PRIVATE KEY-----\n"
            "b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAAB\n"
            "-----END OPENSSH PRIVATE KEY-----\n"
            "osd_pool_default_size = 3\n"
        )
    if remote == "config dump --format json-pretty" and os.environ.get(
        "FAKE_CEPH_WHITESPACE_SECRET"
    ):
        emit("private\vkey: whitespace-must-redact")
    if remote == "config dump --format json-pretty" and os.environ.get(
        "FAKE_CEPH_LONG_GAP_SECRET"
    ):
        emit("private" + " " * (128 * 1024) + "key: long-gap-must-redact")
    if remote in CEPH_RESPONSES:
        emit(CEPH_RESPONSES[remote])

    if remote == "crash ls --format json-pretty":
        if os.environ.get("FAKE_SSH_CRASH_LS_BROKEN"):
            emit("{not-json")
        if os.environ.get("FAKE_SSH_CRASH_LS_EMPTY"):
            emit("[]")
        emit(json.dumps([{"crash_id": crash_id} for crash_id in CRASH_IDS], indent=2))

    if remote.startswith("crash info "):
        crash_id = remote.removeprefix("crash info ")
        if crash_id in CRASH_IDS[:10]:
            emit(json.dumps({"crash_id": crash_id, "detail": f"detail for {crash_id}"}))

    reject("remote ceph command is not whitelisted")


arguments = sys.argv[1:]
log_path = os.environ.get("FAKE_SSH_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as output:
        output.write(json.dumps(arguments) + "\n")

tail = remaining_after_base_options(arguments)

if "-vvv" in tail:
    serve_debug_probe(tail)

if not tail or SSH_TARGET.fullmatch(tail[0]) is None:
    reject("SSH target")
target = tail[0]
tail = tail[1:]

if len(tail) == 1:
    if tail[0] == CAPABILITY_PROBE:
        serve_capability_probe(tail)
    serve_bootstrap(tail[0])

if tail[-3:] == ["--connect-timeout", "5", "-s"]:
    serve_ceph_probe(tail, target)

if tail[:1] == ["ceph"]:
    serve_ceph(tail[1:])

if tail[:3] == ["sudo", "-n", "ceph"]:
    serve_ceph(tail[3:])

reject("remote command shape")
