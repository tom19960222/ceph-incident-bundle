#!/usr/bin/env python3
"""Local-Rook adapter for Prometheus tests that use a free-form since value."""

from __future__ import annotations

import os
import sys
from pathlib import Path


ROOK_KUBECTL = (
    Path(__file__).resolve().parents[2] / "python-rook" / "bin" / "kubectl"
)
arguments = [
    "--since=24h" if word == "--since=yesterday" else word
    for word in sys.argv[1:]
]
os.execv(sys.executable, [sys.executable, str(ROOK_KUBECTL), *arguments])
