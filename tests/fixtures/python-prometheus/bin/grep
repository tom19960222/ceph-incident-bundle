#!/usr/bin/env python3
"""Whitelist and ledger the POSIX ERE grep boundary used by Prometheus tests."""

from __future__ import annotations

import json
import os
import sys


arguments = sys.argv[1:]
log_path = os.environ.get("FAKE_GREP_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as output:
        output.write(json.dumps(arguments) + "\n")

if len(arguments) != 3 or arguments[:2] != ["-qiE", "--"]:
    sys.stderr.write(f"unexpected grep argv: {arguments!r}\n")
    raise SystemExit(99)

for candidate in ("/usr/bin/grep", "/bin/grep"):
    if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
        os.execve(candidate, [candidate, *arguments], os.environ)

sys.stderr.write("real grep unavailable to fixture\n")
raise SystemExit(99)
