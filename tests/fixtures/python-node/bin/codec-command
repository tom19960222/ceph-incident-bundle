#!/bin/sh
set -eu

command_name=${0##*/}
if [ -n "${FAKE_NODE_COMMAND_LOG:-}" ]; then
  printf '%s %s\n' "$command_name" "$*" >>"$FAKE_NODE_COMMAND_LOG"
fi

case "$command_name:$*" in
  "gzip:-dc"|"xz:-dc"|"bzip2:-dc"|"zstd:-qdc") ;;
  gzip:-c\ *) ;;
  *)
    printf 'unexpected fake codec command: %s %s\n' "$command_name" "$*" >&2
    exit 64
    ;;
esac

case "$command_name" in
  gzip) exec "$FAKE_REAL_GZIP" "$@" ;;
  xz) exec "$FAKE_REAL_XZ" "$@" ;;
  bzip2) exec "$FAKE_REAL_BZIP2" "$@" ;;
  zstd) exec "$FAKE_REAL_ZSTD" "$@" ;;
esac
