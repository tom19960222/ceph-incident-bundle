#!/usr/bin/env python3
from __future__ import annotations

import io
import json
import os
import subprocess
import sys
import tarfile


arguments = sys.argv[1:]
remote_command = arguments[-1]
mode = os.environ.get("FAKE_SSH_MODE", "execute")
log_path = os.environ.get("FAKE_SSH_LOG")
if log_path:
    with open(log_path, "w", encoding="utf-8") as output:
        json.dump(arguments, output)

if mode == "timeout":
    os.execve(
        "/bin/sh",
        ["sh", "-c", "exec " + remote_command],
        os.environ,
    )

payload = sys.stdin.buffer.read()
payload_path = os.environ.get("FAKE_SSH_PAYLOAD")
if payload_path:
    with open(payload_path, "wb") as output:
        output.write(payload)

if mode == "unsupported":
    print("SKIPPED: Python 3.11 or newer is required", file=sys.stderr)
    raise SystemExit(75)
if mode == "missing-python":
    print("python3: command not found", file=sys.stderr)
    raise SystemExit(127)
if mode == "corrupt":
    sys.stdout.buffer.write(b"not a gzip stream\n")
    raise SystemExit(0)
if mode in ("missing-manifest", "unsafe"):
    archive_buffer = io.BytesIO()
    with tarfile.open(fileobj=archive_buffer, mode="w:gz") as archive:
        member = tarfile.TarInfo(
            "system/hostname.txt" if mode == "missing-manifest" else "../escape.txt"
        )
        member_payload = b"must not escape\n"
        member.size = len(member_payload)
        archive.addfile(member, io.BytesIO(member_payload))
    sys.stdout.buffer.write(archive_buffer.getvalue())
    raise SystemExit(0)

result = subprocess.run(
    ["/bin/sh", "-c", "exec " + remote_command],
    input=payload,
    stdout=subprocess.PIPE,
    stderr=sys.stderr.buffer,
    check=False,
)
archive_payload = result.stdout
if mode == "truncated" and archive_payload:
    archive_payload = archive_payload[:-8]
sys.stdout.buffer.write(archive_payload)
raise SystemExit(result.returncode)
