#!/usr/bin/env bash
set -euo pipefail

# Fake curl for tests. Emulates exactly the argv shape prom_curl produces:
#   curl -q -fsS -G --connect-timeout T --max-time T -o OUT URL [--data-urlencode P]...
# Knobs (env):
#   FAKE_CURL_LOG           append each invocation's argv here (required)
#   FAKE_CURL_ARGV_LOG      optional lossless NUL-delimited argv ledger
#   FAKE_CURL_DOWN=1        every request fails as a connect error (exit 7)
#   FAKE_CURL_ECHO_URL_ON_ERROR=1 include the requested URL in failure stderr
#   FAKE_CURL_FAIL_PATHS    space-separated URL substrings whose requests 500
#   FAKE_CURL_TIMEOUT_PATHS space-separated URL substrings that hit --max-time
#   FAKE_CURL_MALFORMED_PATHS space-separated URL substrings answered 200 with
#                           a body that is not a Prometheus JSON response
#   FAKE_CURL_FAIL_METRICS  space-separated metrics whose query_range 500s
#   FAKE_CURL_JOBS_JSON     override the /label/job/values response body
#   FAKE_CURL_NAMES_JSON    override the /label/__name__/values response body

printf '%s\n' "$*" >>"${FAKE_CURL_LOG:?}"
if [[ -n "${FAKE_CURL_ARGV_LOG:-}" ]]; then
  printf '%s\0' "$@" >>"$FAKE_CURL_ARGV_LOG"
  printf '\0' >>"$FAKE_CURL_ARGV_LOG"
fi

args=("$@")
n=${#args[@]}
if [[ $n -lt 10 \
  || "${args[0]}" != "-q" \
  || "${args[1]}" != "-fsS" \
  || "${args[2]}" != "-G" \
  || "${args[3]}" != "--connect-timeout" \
  || ! "${args[4]}" =~ ^[1-9][0-9]*$ \
  || "${args[5]}" != "--max-time" \
  || ! "${args[6]}" =~ ^[1-9][0-9]*$ \
  || "${args[7]}" != "-o" \
  || -z "${args[8]}" \
  || "${args[9]}" == -* ]]; then
  printf 'fake curl: unexpected argv: %s\n' "$*" >&2
  exit 99
fi

out="${args[8]}"
url="${args[9]}"
params=()
j=10
while [[ $j -lt $n ]]; do
  if [[ "${args[$j]}" != "--data-urlencode" || $((j + 1)) -ge $n ]]; then
    printf 'fake curl: unexpected argv: %s\n' "$*" >&2
    exit 99
  fi
  params+=("${args[$((j + 1))]}")
  j=$((j + 2))
done

if [[ "${FAKE_CURL_DOWN:-}" == "1" ]]; then
  if [[ "${FAKE_CURL_ECHO_URL_ON_ERROR:-}" == "1" ]]; then
    printf 'curl: (7) Failed to connect to %s\n' "$url" >&2
  else
    printf 'curl: (7) Failed to connect to prometheus\n' >&2
  fi
  exit 7
fi

for fp in ${FAKE_CURL_FAIL_PATHS:-}; do
  case "$url" in
    *"$fp"*)
      # mimic real curl creating/truncating the -o output before failing
      [[ -n "$out" ]] && printf 'partial' >"$out"
      printf 'curl: (22) The requested URL returned error: 500\n' >&2
      exit 22
      ;;
  esac
done

for tp in ${FAKE_CURL_TIMEOUT_PATHS:-}; do
  case "$url" in
    *"$tp"*)
      # curl enforcing --max-time itself: no body, exit 28
      [[ -n "$out" ]] && : >"$out"
      printf 'curl: (28) Operation timed out after 5000 milliseconds\n' >&2
      exit 28
      ;;
  esac
done

for mp in ${FAKE_CURL_MALFORMED_PATHS:-}; do
  case "$url" in
    *"$mp"*)
      # a 200 that is not a Prometheus response (proxy error page, truncation)
      [[ -n "$out" ]] && printf '<html>502 Bad Gateway</html>' >"$out"
      exit 0
      ;;
  esac
done

param_for() {
  local key=$1 p
  for p in "${params[@]+"${params[@]}"}"; do
    case "$p" in "$key="*) printf '%s' "${p#"$key"=}" ;; esac
  done
}

case "$url" in
  */api/v1/status/buildinfo)
    printf '{"status":"success","data":{"version":"2.51.0","revision":"fake"}}' >"$out"
    ;;
  */api/v1/targets)
    printf '{"status":"success","data":{"activeTargets":[{"labels":{"job":"ceph"}}]}}' >"$out"
    ;;
  */api/v1/label/job/values)
    if [[ -n "${FAKE_CURL_JOBS_JSON:-}" ]]; then
      printf '%s' "$FAKE_CURL_JOBS_JSON" >"$out"
    else
      printf '{"status":"success","data":["ceph","node-exporter","grafana"]}' >"$out"
    fi
    ;;
  */api/v1/label/__name__/values)
    if [[ -n "${FAKE_CURL_NAMES_JSON:-}" ]]; then
      printf '%s' "$FAKE_CURL_NAMES_JSON" >"$out"
      exit 0
    fi
    m="$(param_for 'match[]')"
    case "$m" in
      *'job="ceph"'*) printf '{"status":"success","data":["ceph_health_status","ceph_osd_up"]}' >"$out" ;;
      *'job="node-exporter"'*) printf '{"status":"success","data":["node_load1"]}' >"$out" ;;
      *) printf '{"status":"success","data":[]}' >"$out" ;;
    esac
    ;;
  */api/v1/query_range)
    q="$(param_for query)"
    metric="${q#*__name__=\"}"
    metric="${metric%%\"*}"
    for fm in ${FAKE_CURL_FAIL_METRICS:-}; do
      if [[ "$metric" == "$fm" ]]; then
        printf 'curl: (22) The requested URL returned error: 500\n' >&2
        exit 22
      fi
    done
    start="$(param_for start)"
    printf '{"status":"success","data":{"resultType":"matrix","result":[{"metric":{"__name__":"%s"},"values":[[%s,"1"]]}]}}' \
      "$metric" "${start:-0}" >"$out"
    ;;
  *)
    printf 'fake curl: unexpected url %s\n' "$url" >&2
    exit 99
    ;;
esac
