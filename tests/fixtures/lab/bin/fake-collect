#!/usr/bin/env python3
"""A stand-in Collect entrypoint for the offline qualification-harness tests.

The harness's own job is orchestration: derive one inventory, run two collects in
order, gate coverage, compare the two bundles, snapshot stable state and check for
residue.  Testing that job needs two entrypoints that produce *real bundles*, not
a real Ceph lab — so this fixture writes the bundle layout the collectors write
and lets each test bend one implementation's output to make one gate fail.

It is also a whitelist.  The qualification argv is a fixed vector, so anything
outside it exits 99 and the suite fails immediately; in particular a run that
enabled `--allow-cephadm-shell` or `--allow-kubectl-exec`, that delegated host
key trust to the collector, or that arrived without the pinned HOME cannot
quietly produce a passing bundle.

Knobs (env), all suffixed with the implementation name so the two runs diverge:
  FAKE_COLLECT_EXIT_<impl>       exit with this code instead of 0
  FAKE_COLLECT_NO_BUNDLE_<impl>  produce no bundle at all
  FAKE_COLLECT_DROP_<impl>       omit these layers (ceph rook prometheus nodes varlog)
  FAKE_COLLECT_SKIP_<impl>       emit only a SKIPPED marker for these layers
  FAKE_COLLECT_DROP_VARLOG_NODE_<impl> omit /var/log for one named node
  FAKE_COLLECT_DIVERGE_<impl>    manifest-exit | extra-artifact | not-json | selection
  FAKE_COLLECT_RESIDUE_<impl>    leave a workspace entry on every node
  FAKE_COLLECT_LOCAL_RESIDUE_<impl> leave a collector-owned local workdir
  FAKE_LAB_RESIDUE_FILE          JSON {address: [lines]} the fake ssh reports back
"""

from __future__ import annotations

import gzip
import io
import json
import os
import re
import shlex
import sys
import tarfile
import time
from pathlib import Path


HOST_ENTRY = re.compile(r'\s*"([^"]+)=([^"]+)"\s*\Z')
LAYERS = ("ceph", "rook", "prometheus", "nodes", "varlog")
FORBIDDEN = ("--allow-cephadm-shell", "--allow-kubectl-exec", "--trust-ssh-host-key")
EXPECTED_TAIL = (
    "--mode",
    "auto",
    "--kube-mode",
    "local",
    "--since",
    "24h",
    "--no-trust-ssh-host-key",
    "--redact",
)

arguments = sys.argv[1:]


def reject(reason: str) -> None:
    sys.stderr.write(
        f"fake collect: unexpected invocation ({reason}): {shlex.join(arguments)}\n"
    )
    raise SystemExit(99)


if len(arguments) < 2 or arguments[0] != "--implementation":
    reject("missing --implementation")
implementation = arguments[1]
rest = arguments[2:]
for forbidden in FORBIDDEN:
    if forbidden in rest:
        reject(f"{forbidden} is not a qualification path")
if tuple(rest[-len(EXPECTED_TAIL) :]) != EXPECTED_TAIL:
    reject("qualification argument vector")

options: dict[str, str] = {}
index = 0
while index < len(rest) - len(EXPECTED_TAIL):
    name = rest[index]
    if name not in ("--inventory", "--ssh-key", "--out", "--prom-url"):
        reject(f"unknown option {name}")
    if index + 1 >= len(rest):
        reject(f"{name} requires a value")
    options[name] = rest[index + 1]
    index += 2
for required in ("--inventory", "--ssh-key", "--out", "--prom-url"):
    if required not in options:
        reject(f"missing {required}")

# The collectors read opt-in defaults and safety-limit overrides from
# `CEPH_INCIDENT_*`, so a qualification run must arrive with none of them: an
# operator with one exported would otherwise get a side-effecting collect while
# the gate reported the opt-ins disabled.
leaked = sorted(name for name in os.environ if name.startswith("CEPH_INCIDENT_"))
if leaked:
    reject(f"collector variables reached the collect: {', '.join(leaked)}")

home = Path(os.environ.get("HOME", ""))
known_hosts = home / ".ssh" / "known_hosts"
if not known_hosts.is_file() or not known_hosts.read_text(encoding="utf-8").strip():
    reject("HOME does not carry the pinned known_hosts")
if not os.environ.get("KUBECONFIG"):
    reject("KUBECONFIG is not set")


def knob(name: str, default: str = "") -> str:
    return os.environ.get(f"FAKE_COLLECT_{name}_{implementation}", default)


inventory_text = Path(options["--inventory"]).read_text(encoding="utf-8")
hosts: list[tuple[str, str]] = []
scalars: dict[str, str] = {}
in_hosts = False
for line in inventory_text.splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    if stripped == "HOSTS=(":
        in_hosts = True
        continue
    if in_hosts:
        if stripped == ")":
            in_hosts = False
            continue
        entry = HOST_ENTRY.fullmatch(line)
        if entry is None:
            reject(f"unreadable HOSTS entry: {line}")
        hosts.append((entry.group(1), entry.group(2)))
        continue
    key, marker, value = stripped.partition("=")
    if marker:
        scalars[key] = value.strip('"')
if not hosts:
    reject("inventory lists no hosts")

exit_code = int(knob("EXIT", "0"))
dropped = set(knob("DROP").split())
skipped = set(knob("SKIP").split())
drop_varlog_node = knob("DROP_VARLOG_NODE")
diverge = knob("DIVERGE")
for layer in dropped | skipped:
    if layer not in LAYERS:
        reject(f"unknown layer knob: {layer}")

collect_marker = os.environ.get("FAKE_LAB_COLLECT_MARKER")
if collect_marker:
    Path(collect_marker).touch()

# The two runs happen at different moments against a live cluster, so the fixture
# deliberately puts a different clock and a different counter in every bundle:
# a comparison that only passes when both runs observe the same numbers would be
# testing the fixture, not the gate.
stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
created = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
counter = int(time.time() * 1000) % 100000
members: dict[str, bytes] = {}
manifest: list[dict[str, object]] = []


# The real collectors record each artifact by its absolute path inside that
# run's own workdir, so the fixture does too: normalising those two different
# directories to the same thing is exactly what the comparison has to get right.
workdir = f"{options['--out']}/tmp.{implementation}01"


def capture(path: str, host: str, collector: str, command: str, body: str, exit_code: int = 0) -> None:
    header = (
        f"# host: {host}\n# collector: {collector}\n"
        f"# started: {created}\n# timeout: 20s\n"
    )
    members[path] = (header + body).encode("utf-8")
    manifest.append(
        {
            "host": host,
            "collector": collector,
            "artifact": f"{workdir}/{path}",
            "command": command,
            "exit_code": exit_code,
            "started": created,
            "ended": created,
        }
    )


def skip(path: str, reason: str) -> None:
    members[path] = f"SKIPPED: {reason}\n".encode("utf-8")


if "ceph" in skipped:
    skip("cluster/ceph/SKIPPED.txt", "no cephadm-capable node found")
elif "ceph" not in dropped:
    status = {"fsid": "3f2b1c8e-0000-4a1d-8b7e-000000000001", "num_osds": 3, "num_pgs": counter}
    # A candidate that wrapped or re-serialised evidence instead of recording the
    # command's output verbatim stops the artifact being JSON at all.
    body = (
        f"cluster status: {status}\n"
        if diverge == "not-json"
        else json.dumps(status) + "\n"
    )
    capture(
        "cluster/ceph/json/status.json",
        "monitor01",
        "cluster-ceph",
        "ssh -i /key monitor01 ceph -s -f json",
        body,
    )
    capture(
        "cluster/ceph/text/health.txt",
        "monitor01",
        "cluster-ceph",
        "ssh -i /key monitor01 ceph health detail",
        f"HEALTH_OK\nchecked at {created}, {counter} pgs\n",
        exit_code=1 if diverge == "manifest-exit" else 0,
    )

if "rook" in skipped:
    skip("cluster/rook/SKIPPED.txt", "rook namespace not found")
elif "rook" not in dropped:
    capture(
        "cluster/rook/pods-wide.txt",
        "local",
        "cluster-rook",
        f"kubectl -n {scalars.get('ROOK_NAMESPACE', 'rook-ceph')} get pods -o wide",
        f"NAME READY\nrook-ceph-mon-a 1/1 {counter}s\n",
    )

if "prometheus" in skipped:
    skip("cluster/prometheus/SKIPPED.txt", "prometheus not reachable")
elif "prometheus" not in dropped:
    capture(
        "cluster/prometheus/targets.json",
        "local",
        "cluster-prometheus",
        f"curl -fsS {options['--prom-url']}/api/v1/targets",
        json.dumps({"status": "success", "data": {"activeTargets": [{"health": "up"}]}}) + "\n",
    )
    members["cluster/prometheus/ceph/up.json.gz"] = gzip.compress(
        json.dumps({"samples": counter}).encode("utf-8")
    )

if "nodes" not in dropped:
    for alias, address in hosts:
        node_manifest = [
            {
                "host": alias,
                "collector": "node",
                "artifact": f"{workdir}/nodes/{alias}/system/hostname.txt",
                "command": "hostname",
                "exit_code": 0,
                "started": created,
                "ended": created,
            }
        ]
        capture(
            f"nodes/{alias}/system/hostname.txt",
            alias,
            "node",
            f"ssh -i /key {scalars.get('SSH_USER', 'operator')}@{address} hostname",
            f"{alias}\n",
        )
        if diverge == "extra-artifact" and alias == hosts[0][0]:
            capture(
                f"nodes/{alias}/system/uptime.txt",
                alias,
                "node",
                "uptime",
                f"up {counter} seconds\n",
            )
        if "varlog" in skipped:
            skip(f"nodes/{alias}/logs/var-log/SKIPPED.txt", "--skip-logs was requested")
        elif "varlog" not in dropped and alias != drop_varlog_node:
            members[f"nodes/{alias}/logs/var-log/INDEX.tsv"] = (
                f"syslog\t{counter}\n".encode("utf-8")
            )
            members[f"nodes/{alias}/logs/var-log/merged/syslog.merged"] = (
                f"{created} {alias} kernel: message {counter}\n".encode("utf-8")
            )
        members[f"nodes/{alias}/manifest.jsonl"] = "".join(
            json.dumps(record) + "\n" for record in node_manifest
        ).encode("utf-8")

environment = [
    f"created_utc={created}",
    "mode=auto",
    f"seed={scalars.get('SSH_USER', 'operator')}@{scalars.get('SEED_HOST', '')}",
    "since=24h",
    "timeout=20",
    "git_commit=fixture",
    "ceph_source=monitor01",
    "ceph_runner=" + ("sudo-ceph" if diverge == "selection" else "ceph"),
    "rook_source=local",
    f"prom_url={options['--prom-url']}",
    "prom_jobs=ceph node",
]
if implementation == "python":
    # The candidate's declared additional observability; the comparison knows
    # these keys are candidate-only and does not read them as a difference.
    for position, (alias, address) in enumerate(hosts):
        environment.append(f"node_target_{alias}={address}")
        environment.append(f"node_invocation_id_{alias}={position:032x}")

members["environment.txt"] = "".join(f"{line}\n" for line in environment).encode("utf-8")
members["summary.txt"] = (
    "Ceph incident bundle summary\n"
    f"created_utc: {created}\n"
    "mode: auto\n"
    f"seed: {scalars.get('SSH_USER', 'operator')}@{scalars.get('SEED_HOST', '')}\n"
    "cluster_status: 0\n"
    f"node_ok: {len(hosts)}\n"
    "node_failed: 0\n"
    f"final_status: {exit_code}\n"
).encode("utf-8")
members["README-FIRST.txt"] = b"Ceph incident bundle\n"
members["errors.log"] = b""
members["manifest.jsonl"] = "".join(
    json.dumps(record) + "\n" for record in manifest
).encode("utf-8")

if knob("RESIDUE"):
    ledger = Path(os.environ["FAKE_LAB_RESIDUE_FILE"])
    try:
        state = json.loads(ledger.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        state = {}
    for _, address in hosts:
        state.setdefault(address, []).append(
            f"workspace\t/tmp/ceph-incident-node.{implementation}0001"
        )
    ledger.write_text(json.dumps(state), encoding="utf-8")

if not knob("NO_BUNDLE"):
    output_root = Path(options["--out"])
    output_root.mkdir(parents=True, exist_ok=True)
    archive = output_root / f"ceph-incident-{stamp}.tar.gz"
    with tarfile.open(archive, "w:gz") as bundle:
        for name in sorted(members):
            payload = members[name]
            info = tarfile.TarInfo(f"./{name}")
            info.size = len(payload)
            info.mode = 0o644
            info.mtime = 0
            bundle.addfile(info, io.BytesIO(payload))
    sys.stdout.write(f"bundle: {archive}\n")
    if knob("LOCAL_RESIDUE"):
        (output_root / f"tmp.{implementation}01").mkdir()

raise SystemExit(exit_code)
