#!/usr/bin/env python3
"""Whitelist fake ssh for the fake lab's read-only identity and state probes.

The full option vector is matched exactly, and only a fixed set of remote
commands is answered: ``hostname``, the direct ``ceph`` reads the identity
preflight and the stable-state snapshot need, and the residue probe (recognised
by its sentinel comment).  Anything else exits 99, so a probe that reaches for
``cephadm shell``, a write verb or an extra option fails the suite immediately.

Host key pinning is enforced, not assumed: the fake refuses to connect unless
``StrictHostKeyChecking=yes`` is set and the collector-owned known_hosts file
already holds a line for the target address.  A probe that trusts a key it never
verified therefore fails the way real ssh would.

Knobs (env):
  FAKE_LAB_SSH_LOG         append each invocation's argv here as one JSON line
  FAKE_LAB_HOST_ALIASES    JSON {address: hostname} the fake lab's default names
  FAKE_LAB_HOSTNAMES       JSON {address: hostname} overriding those defaults
  FAKE_LAB_CEPH_FSID       the FSID `ceph fsid` reports
  FAKE_LAB_CEPH_DIRECT_FAIL  `ceph fsid` fails so only `sudo -n ceph` answers
  FAKE_LAB_CEPH_FAIL       both Ceph runners fail
  FAKE_LAB_SSH_UNREACHABLE space-separated addresses that refuse the connection
  FAKE_LAB_CEPH_STATE      JSON {subcommand: document} overriding the stable state
  FAKE_LAB_CEPH_STATE_FAIL space-separated ceph subcommands that fail
  FAKE_LAB_RESIDUE_FILE    JSON {address: ["workspace\\t...", "process\\t..."]}
  FAKE_LAB_RESIDUE_FAIL    space-separated addresses whose residue probe fails
"""

from __future__ import annotations

import json
import os
import re
import shlex
import sys


IDENTITY_PATH = re.compile(r"[^-\s]\S*")
CONNECT_TIMEOUT = re.compile(r"ConnectTimeout=[1-9][0-9]*")
KNOWN_HOSTS_FILE = re.compile(r"UserKnownHostsFile=(\S.*)")
SSH_TARGET = re.compile(r"([A-Za-z0-9._%+-]+)@(\[[0-9A-Fa-f:]+\]|[A-Za-z0-9._:-]+)")

EXPECTED = (
    "-i",
    IDENTITY_PATH,
    "-o",
    "BatchMode=yes",
    "-o",
    "IdentitiesOnly=yes",
    "-o",
    "IdentityAgent=none",
    "-o",
    "LogLevel=ERROR",
    "-o",
    CONNECT_TIMEOUT,
    "-o",
    "StrictHostKeyChecking=yes",
    "-o",
    KNOWN_HOSTS_FILE,
)
CEPH_SUBCOMMANDS = (
    "fsid",
    "mon dump --format json",
    "osd tree --format json",
    "osd pool ls detail --format json",
    "config dump --format json",
)
REMOTE_COMMANDS = ("hostname",) + tuple(
    f"{runner} {subcommand}"
    for runner in ("ceph", "sudo -n ceph")
    for subcommand in CEPH_SUBCOMMANDS
)
RESIDUE_SENTINEL = "# ceph-incident-residue-probe"
# The stable state a healthy fake lab reports.  Every value here is identity or
# desired configuration; the snapshot projection is what decides that, so the
# fixture also serves volatile fields (epochs, counters, status) to prove they
# are dropped rather than merely absent.
DEFAULT_CEPH_STATE = {
    "mon dump --format json": {
        "epoch": 7,
        "fsid": "3f2b1c8e-0000-4a1d-8b7e-000000000001",
        "modified": "2026-07-31T00:00:00.000000+0000",
        "election_epoch": 42,
        "quorum": [0, 1],
        "mons": [
            {"rank": 0, "name": "monitor01", "public_addr": "10.0.0.11:6789/0"},
            {"rank": 1, "name": "mon02", "public_addr": "10.0.0.12:6789/0"},
        ],
    },
    "osd tree --format json": {
        "nodes": [
            {
                "id": -1,
                "name": "default",
                "type": "root",
                "children": [0, 1],
                "crush_weight": 0,
            },
            {
                "id": 0,
                "name": "osd.0",
                "type": "osd",
                "device_class": "ssd",
                "crush_weight": 0.5,
                "children": [],
                "status": "up",
                "reweight": 1.0,
            },
        ],
        "stray": [],
    },
    "osd pool ls detail --format json": [
        {
            "pool_id": 1,
            "pool_name": "replicapool",
            "type": 1,
            "size": 3,
            "min_size": 2,
            "pg_num": 32,
            "pg_num_target": 32,
            "crush_rule": 0,
            "erasure_code_profile": "",
            "application_metadata": {"rbd": {}},
            "last_change": "191",
        }
    ],
    "config dump --format json": [
        {
            "section": "global",
            "name": "osd_pool_default_size",
            "value": "3",
            "level": "advanced",
            "can_update_at_runtime": True,
        }
    ],
}

arguments = sys.argv[1:]
log_path = os.environ.get("FAKE_LAB_SSH_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as output:
        output.write(json.dumps(arguments) + "\n")


def reject(reason: str) -> None:
    sys.stderr.write(f"fake ssh: unexpected argv ({reason}): {shlex.join(arguments)}\n")
    raise SystemExit(99)


if len(arguments) != len(EXPECTED) + 2:
    reject("argument count")
for index, expected in enumerate(EXPECTED):
    actual = arguments[index]
    if isinstance(expected, re.Pattern):
        if expected.fullmatch(actual) is None:
            reject(f"option {index}")
    elif expected != actual:
        reject(f"option {index}")

target = SSH_TARGET.fullmatch(arguments[-2])
if target is None:
    reject("ssh target")
address = target.group(2)
remote = arguments[-1]
is_residue_probe = remote.startswith(RESIDUE_SENTINEL)
if not is_residue_probe and remote not in REMOTE_COMMANDS:
    reject("remote command is not whitelisted")

known_hosts = KNOWN_HOSTS_FILE.fullmatch(arguments[len(EXPECTED) - 1]).group(1)
try:
    with open(known_hosts, encoding="utf-8") as source:
        pinned = [line.split(" ")[0] for line in source.read().splitlines() if line]
except OSError:
    pinned = []
if address not in pinned:
    sys.stderr.write(f"Host key verification failed for {address}.\n")
    raise SystemExit(255)

if address in os.environ.get("FAKE_LAB_SSH_UNREACHABLE", "").split():
    sys.stderr.write(f"ssh: connect to host {address} port 22: Connection refused\n")
    raise SystemExit(255)

if is_residue_probe:
    if address in os.environ.get("FAKE_LAB_RESIDUE_FAIL", "").split():
        sys.stderr.write("sh: ps: command not found\n")
        raise SystemExit(127)
    ledger = os.environ.get("FAKE_LAB_RESIDUE_FILE")
    entries: list[str] = []
    if ledger:
        try:
            with open(ledger, encoding="utf-8") as source:
                entries = json.load(source).get(address, [])
        except (OSError, ValueError):
            entries = []
    for entry in entries:
        sys.stdout.write(entry + "\n")
    raise SystemExit(0)

if remote == "hostname":
    hostnames = {
        **json.loads(os.environ.get("FAKE_LAB_HOST_ALIASES", "{}")),
        **json.loads(os.environ.get("FAKE_LAB_HOSTNAMES", "{}")),
    }
    sys.stdout.write(hostnames.get(address, address) + "\n")
    raise SystemExit(0)

subcommand = remote.split("ceph ", 1)[1]
if os.environ.get("FAKE_LAB_CEPH_FAIL"):
    sys.stderr.write("unable to get monitor info from DNS SRV with service name: ceph-mon\n")
    raise SystemExit(1)
if subcommand in os.environ.get("FAKE_LAB_CEPH_STATE_FAIL", "").split("|"):
    sys.stderr.write(f"Invalid command: {subcommand}\n")
    raise SystemExit(22)
if subcommand == "fsid":
    if remote == "ceph fsid" and os.environ.get("FAKE_LAB_CEPH_DIRECT_FAIL"):
        sys.stderr.write("[errno 13] RADOS permission denied\n")
        raise SystemExit(1)
    sys.stdout.write(
        os.environ.get("FAKE_LAB_CEPH_FSID", "3f2b1c8e-0000-4a1d-8b7e-000000000001") + "\n"
    )
    raise SystemExit(0)

state = {
    **DEFAULT_CEPH_STATE,
    **json.loads(os.environ.get("FAKE_LAB_CEPH_STATE", "{}")),
}
sys.stdout.write(json.dumps(state[subcommand]) + "\n")
raise SystemExit(0)
