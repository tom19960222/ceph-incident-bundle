#!/usr/bin/env python3
"""A stand-in Verify entrypoint for the offline qualification-harness tests.

The gate treats verification as pass/fail on one bundle path, so the fixture only
has to answer that — and to prove it was asked about a bundle that exists.

Knobs (env):
  FAKE_VERIFY_FAIL_<impl>  fail verification for this implementation's bundle
"""

from __future__ import annotations

import os
import shlex
import sys
from pathlib import Path


arguments = sys.argv[1:]
if len(arguments) != 3 or arguments[0] != "--implementation":
    sys.stderr.write(f"fake verify: unexpected argv: {shlex.join(arguments)}\n")
    raise SystemExit(99)
# Verification reads its payload caps from `CEPH_INCIDENT_TEST_*`, so the gate
# must clear those before verifying too — see the same check in `fake-collect`.
leaked = sorted(name for name in os.environ if name.startswith("CEPH_INCIDENT_"))
if leaked:
    sys.stderr.write(f"fake verify: collector variables leaked: {', '.join(leaked)}\n")
    raise SystemExit(99)
implementation, bundle = arguments[1], Path(arguments[2])
if not bundle.is_file():
    sys.stderr.write(f"VERIFY FAIL: missing bundle: {bundle}\n")
    raise SystemExit(1)
if os.environ.get(f"FAKE_VERIFY_FAIL_{implementation}"):
    sys.stderr.write(f"VERIFY FAIL: unredacted key material in: {bundle}\n")
    raise SystemExit(1)
sys.stdout.write(f"VERIFY PASS: {bundle}\n")
raise SystemExit(0)
