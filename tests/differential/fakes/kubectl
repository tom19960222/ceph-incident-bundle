#!/usr/bin/env python3
"""The one fake kubectl both implementations use for the Rook layer.

Only the read-only verb ledger the Rook collector is allowed to issue is
answered; `exec`, any mutating verb, `--kubeconfig` or an extra token exits 99,
so neither implementation can widen its Kubernetes command surface inside the
differential gate.  Every invocation is appended to `FAKE_KUBECTL_LOG`.
"""

from __future__ import annotations

import json
import os
import shlex
import sys


ROOK_RESOURCE_KINDS = (
    "cephclusters.ceph.rook.io,cephblockpools.ceph.rook.io,"
    "cephfilesystems.ceph.rook.io,cephobjectstores.ceph.rook.io"
)

arguments = sys.argv[1:]
log_path = os.environ.get("FAKE_KUBECTL_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as output:
        output.write(json.dumps(arguments) + "\n")


def reject() -> None:
    sys.stderr.write(f"unexpected kubectl: {shlex.join(arguments)}\n")
    raise SystemExit(99)


def emit(payload: str) -> None:
    sys.stdout.write(payload)
    raise SystemExit(0)


words = list(arguments)
if words[:1] == ["--context"]:
    if len(words) < 2:
        reject()
    context = words[1]
    if context != os.environ.get("FAKE_KUBE_CONTEXT", "lab"):
        sys.stderr.write(f'error: no context exists with the name: "{context}"\n')
        raise SystemExit(1)
    words = words[2:]

mode = os.environ.get("FAKE_KUBE_MODE", "present")
namespace = os.environ.get("FAKE_KUBE_NAMESPACE", "rook-ceph")

if words[:2] == ["get", "namespace"] and len(words) == 3:
    if mode == "missing-namespace":
        sys.stderr.write(
            f'Error from server (NotFound): namespaces "{words[2]}" not found\n'
        )
        raise SystemExit(1)
    if mode == "connection-refused":
        sys.stderr.write(
            "The connection to the server 10.0.0.9:6443 was refused - "
            "did you specify the right host or port?\n"
        )
        raise SystemExit(1)
    emit(f"NAME STATUS AGE\n{words[2]} Active 30d\n")

if words == ["get", "pods", "-n", namespace, "-o", "wide"]:
    emit("NAME READY STATUS NODE\nrook-ceph-mon-a-0 1/1 Running kubenode\n")

if words == ["get", "events", "-n", namespace, "--sort-by=.lastTimestamp"]:
    emit("LAST SEEN TYPE REASON OBJECT\n1m Normal Scheduled pod/rook-ceph-mon-a-0\n")

if words == ["get", ROOK_RESOURCE_KINDS, "-n", namespace, "-o", "yaml"]:
    emit(
        "apiVersion: v1\nitems:\n- kind: CephCluster\n  metadata:\n"
        f"    name: rook-ceph\n    namespace: {namespace}\n"
    )

if (
    words[:3] == ["get", "pods", "-n"]
    and words[4:5] == ["-l"]
    and words[6:] == ["-o", "name"]
):
    label = words[5]
    if label == "app=rook-ceph-operator":
        if os.environ.get("FAKE_KUBE_OPERATOR_MISSING"):
            emit("")
        emit("pod/rook-ceph-operator-0\n")
    if label == "app=rook-ceph-tools":
        if os.environ.get("FAKE_KUBE_TOOLS_POD"):
            emit("pod/rook-ceph-tools-0\n")
        emit("")
    reject()

if (
    words[:2] == ["logs", "-n"]
    and len(words) == 5
    and words[3] == "rook-ceph-operator-0"
    and words[4].startswith("--since=")
):
    emit("2026-07-29T00:00:00Z operator reconciled CephCluster\n")

reject()
