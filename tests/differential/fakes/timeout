#!/usr/bin/env python3
"""A GNU-compatible `timeout` the shell reference can always find.

The shell collector bounds every command with `timeout`, and records
`# timeout: unavailable` when the host has none — macOS included.  The
differential gate must compare two collectors, not two host toolchains, so this
fixture guarantees the same bounded-execution semantics everywhere: SIGTERM at
the deadline, exit 124, and the child's exit code otherwise.
"""

from __future__ import annotations

import os
import signal
import subprocess
import sys


if len(sys.argv) < 3:
    sys.stderr.write("usage: timeout SECONDS COMMAND [ARG...]\n")
    raise SystemExit(125)

seconds = float(sys.argv[1])
command = sys.argv[2:]

log_path = os.environ.get("FAKE_TIMEOUT_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as output:
        output.write(f"{sys.argv[1]}\n")

try:
    process = subprocess.Popen(command)
except FileNotFoundError:
    sys.stderr.write(f"timeout: failed to run command '{command[0]}'\n")
    raise SystemExit(127) from None

try:
    status = process.wait(timeout=seconds)
    # A signalled child is reported the way a shell reports it, so the
    # collectors classify 137/143 identically to a real timeout(1).
    raise SystemExit(status if status >= 0 else 128 - status)
except subprocess.TimeoutExpired:
    process.send_signal(signal.SIGTERM)
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
    raise SystemExit(124) from None
